{
  "name": "orca-x",
  "private": true,
  "version": "1.0.0",
  "description": "ORCA-X marine intelligence platform — HackHeritage",
  "type": "module",
  "scripts": {
    "dev:console": "vite --port 3001 --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "legacy:analyze:realtime": "python ../legacy/ml-service/ml/src/analyze_realtime_source_bias.py",
    "legacy:dev": "tsx ../legacy/express-backend/server/app.ts",
    "legacy:dev:all": "node ../legacy/dev-scripts/scripts/dev-all.mjs",
    "legacy:dev:ml": "cd ../legacy/ml-service && uvicorn ml.api:app --reload --host 0.0.0.0 --port 8000",
    "legacy:dev:rag": "cd ../legacy/ml-service && uvicorn ml.rag_api:app --reload --host 0.0.0.0 --port 8001",
    "legacy:evaluate:realtime-ml": "python ../legacy/ml-service/ml/src/evaluate_live_candidate.py",
    "legacy:health": "node ../legacy/dev-scripts/scripts/system-health.mjs",
    "legacy:import:realtime-ml": "python ../legacy/ml-service/ml/src/import_realtime_telemetry.py",
    "legacy:ingest:rag": "tsx ../legacy/dev-scripts/scripts/ingest-rag.mjs",
    "legacy:smoke": "node ../legacy/dev-scripts/scripts/smoke-test.mjs",
    "legacy:start": "node -e \"process.env.ORCA_PRODUCTION='true'; require('./dist/server.cjs')\"",
    "legacy:start:ml": "cd ../legacy/ml-service && uvicorn ml.api:app --host 0.0.0.0 --port 8000",
    "legacy:start:rag": "cd ../legacy/ml-service && uvicorn ml.rag_api:app --host 0.0.0.0 --port 8001",
    "legacy:sync:mosdac": "python ../legacy/dev-scripts/scripts/mosdac-sync.py",
    "legacy:sync:realtime-ml": "python ../legacy/ml-service/ml/src/realtime_data_daemon.py",
    "legacy:test:agentic": "tsx ../legacy/dev-scripts/scripts/test-agentic-executor.ts",
    "legacy:test:agentic-alerts": "tsx ../legacy/dev-scripts/scripts/test-agentic-alerts.ts",
    "legacy:test:agentic-pfz": "tsx ../legacy/dev-scripts/scripts/test-agentic-pfz.ts",
    "legacy:test:agentic-safe-routing": "tsx ../legacy/dev-scripts/scripts/test-agentic-safe-routing.ts",
    "legacy:test:agentic-workflow": "node ../legacy/dev-scripts/scripts/test-agentic-workflow.mjs",
    "legacy:test:alerts": "tsx ../legacy/dev-scripts/scripts/test-alert-engine.ts",
    "legacy:test:all-languages": "tsx ../legacy/dev-scripts/scripts/test-all-10-languages-all-warnings.ts",
    "legacy:test:conversation": "tsx ../legacy/dev-scripts/scripts/test-conversation-session.ts",
    "legacy:test:decision-fusion": "tsx ../legacy/dev-scripts/scripts/test-decision-fusion.ts",
    "legacy:test:forecast": "tsx ../legacy/dev-scripts/scripts/test-marine-forecast.ts",
    "legacy:test:geofence": "tsx ../legacy/dev-scripts/scripts/test-geofence.ts",
    "legacy:test:gis": "tsx ../legacy/dev-scripts/scripts/test-gis-intelligence.ts",
    "legacy:test:gis-agentic": "tsx ../legacy/dev-scripts/scripts/test-gis-agentic-integration.ts",
    "legacy:test:hybrid-types": "tsx ../legacy/dev-scripts/scripts/test-all-hybrid-types.ts",
    "legacy:test:isro-benchmarks": "tsx ../legacy/dev-scripts/scripts/test-all-8-isro-queries.ts",
    "legacy:test:maritime-audio": "tsx ../legacy/dev-scripts/scripts/test-maritime-audio.ts",
    "legacy:test:mosdac-cache": "tsx ../legacy/dev-scripts/scripts/test-mosdac-cache.ts",
    "legacy:test:multilingual-e2e": "tsx ../legacy/dev-scripts/scripts/test-multilingual-e2e.ts",
    "legacy:test:pfz": "tsx ../legacy/dev-scripts/scripts/test-pfz.ts",
    "legacy:test:rag": "tsx ../legacy/dev-scripts/scripts/test-rag-evidence.ts",
    "legacy:test:safe-routing": "tsx ../legacy/dev-scripts/scripts/test-safe-routing.ts",
    "legacy:verify:realtime": "node ../legacy/dev-scripts/scripts/verify-marine-sources.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.0.4",
    "animejs": "^4.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.13",
    "vite": "^6.2.3"
  }
}
