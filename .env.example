# ORCA-X environment template
# Copy this file to .env for local development.

# Server
PORT="3000"
NODE_ENV="development"

# Live real-time environmental data
OPEN_METEO_WEATHER_API_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_MARINE_API_URL="https://marine-api.open-meteo.com/v1/marine"
REALTIME_DATA_TIMEOUT_MS="15000"
REALTIME_MAX_STALENESS_HOURS="3"

# INCOIS public ERDDAP (Indian Argo). This is an auxiliary in-situ source:
# it contributes near-surface temperature when a sufficiently fresh profile exists.
# It does NOT replace live wind/wave data.
INCOIS_ERDDAP_ENABLED="true"
INCOIS_ERDDAP_URL="https://erddap.incois.gov.in/erddap/tabledap/Indian_ARGO_Floats.json"
INCOIS_ERDDAP_SEARCH_RADIUS_DEG="2"
INCOIS_ERDDAP_MAX_LOOKBACK_DAYS="3650"

# MOSDAC / ISRO normalized source.
# Preferred production mode: set MOSDAC_REALTIME_URL to an approved internal gateway
# that returns the documented ORCA-X normalized JSON contract.
# Local/demo mode: set MOSDAC_REALTIME_CACHE_FILE to a JSON snapshot produced from
# an official MOSDAC API download. Never put MOSDAC credentials in this repository.
MOSDAC_REALTIME_URL=""
MOSDAC_REALTIME_CACHE_FILE="data/realtime/mosdac_latest.json"
MOSDAC_MAX_CACHE_DISTANCE_DEG="2"
MOSDAC_MAX_CACHE_STALENESS_HOURS="36"

# Persistent heterogeneous-source telemetry
# JSONL is append-only and survives server restarts when the path is on persistent storage.
ORCA_TELEMETRY_PATH="data/realtime/marine_telemetry.jsonl"
REALTIME_TELEMETRY_MAX_EVENTS="5000"
REALTIME_COLLECTION_ENABLED="false"
REALTIME_COLLECTION_INTERVAL_MS="900000"
REALTIME_COLLECTION_LOCATIONS="digha,paradeep,visakhapatnam,chennai,goa,kochi"

# ML live-data synchronization. This reads the server's fused telemetry and maintains
# ml/data/processed/live/live_observations.parquet. It never trains/promotes a model.
REALTIME_ML_SYNC_INTERVAL_SECONDS="900"
REALTIME_ML_LOCATION_MATCH_DEG="0.25"

# Realtime evidence gate (analysis only; never modifies/trains a model)
REALTIME_ANALYSIS_MIN_EVENTS="100"
REALTIME_ANALYSIS_MIN_LIVE_SOURCES="2"
REALTIME_ANALYSIS_MIN_LIVE_RATE="0.80"
REALTIME_ANALYSIS_MIN_PAIRWISE_SAMPLES="50"
REALTIME_ANALYSIS_MIN_SOURCE_QUALITY="0.60"

# Gemini grounding / response synthesis
GEMINI_API_KEY=""

# Public app URL (optional metadata)
APP_URL="http://localhost:3000"

# Copernicus Data Space STAC catalogue endpoint
COPERNICUS_STAC_URL="https://stac.dataspace.copernicus.eu/v1"

# Dedicated XGBoost ML service
ORCA_ML_API_URL="http://127.0.0.1:8000"
ORCA_ML_API_TIMEOUT_MS="3500"

# Refinement 3 — real BGE-M3 + Qdrant RAG
QDRANT_URL="http://127.0.0.1:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="orca_marine_evidence"
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DEVICE="cpu"
ORCA_RAG_API_URL="http://127.0.0.1:8001"
ORCA_RAG_API_TIMEOUT_MS="2500"
RAG_TOP_K="8"

# Never commit real credentials. Store secrets only in the local .env / deployment secret manager.
KAGGLE_API_TOKEN=""
